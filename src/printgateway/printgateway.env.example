# Copy to /etc/printgateway/printgateway.env (root:root, mode 600) and fill
# in real values - never commit a filled-in copy of this file. See
# src/printgateway/README.md for the full list and meaning of every variable;
# only the ones an install almost always needs are named here.

# Required unless Vault (VAULT_ADDR/SECRET_STORE_URL below) is configured:
# the shared secret calling systems present as X-Labos-Print-Token.
PRINT_GATEWAY_TOKEN=

# Optional: PORT (or the higher-precedence PRINT_GATEWAY_PORT) picks the listen
# port, default 8090. PRINT_GATEWAY_BIND_HOST picks the interface, default
# 0.0.0.0 (every interface, for Nomad/Consul/Traefik reachability) - set it to
# 127.0.0.1 here to keep this systemd deployment closed to the local machine only.
#PORT=8090
#PRINT_GATEWAY_BIND_HOST=127.0.0.1

# Optional: HOST_IP has no systemd specifier equivalent (unlike HOST_NAME,
# set directly in printgateway.service). Read by go-packages/logs once
# LOG_SERVER below is set - left unset, shipped log records render this
# field as the literal string "NO_VAL".
HOST_IP=

# Optional: HashiCorp Vault, in place of PRINT_GATEWAY_TOKEN above. See
# README's "Secrets (Vault)" section for the fallback policy.
#VAULT_ADDR=
#VAULT_TOKEN=
#SECRET_STORE_USERNAME=
#SECRET_STORE_PASSWORD=
#LABOS_ENV=

# Optional: ship logs to logstash now instead of console-only.
#LOG_SERVER=

# Optional: S3/MinIO object storage (fetch-by-key + presigned URLs).
#PRINT_GATEWAY_S3_ENDPOINT=
#PRINT_GATEWAY_S3_BUCKET=
#PRINT_GATEWAY_S3_REGION=
#PRINT_GATEWAY_S3_ACCESS_KEY=
#PRINT_GATEWAY_S3_SECRET_KEY=

# Optional: a JSON config file that overrides the settings above (see
# README's "Configuration file" section for precedence, format, and the
# settings it can and cannot carry - secrets and PRINT_GATEWAY_ALLOW_PRIVATE_TARGETS
# never belong in it). install-services.sh installs
# /etc/printgateway/printservice.config.json when one exists at the repo
# root, but does NOT set this variable - deliberately left commented out
# here too, so turning the file on is always an explicit, per-deployment
# choice, never a default. A bind-mounted/copied file that later goes
# missing turns a healthy service into a startup failure, which is exactly
# why this stays opt-in.
#PRINT_GATEWAY_CONFIG=/etc/printgateway/printservice.config.json
