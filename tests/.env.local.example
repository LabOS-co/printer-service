# Copy to tests/.env.local — or just run tests/scripts/bootstrap.sh, which
# generates it with fresh random tokens and leaves the backend blocks commented.
#
# .env.local is git-ignored. Nothing here belongs in the repository.

# ---------------------------------------------------------------------------
# Print tokens
# ---------------------------------------------------------------------------
# The shared secret for the environment-sourced profiles (A, C, E, F, G).
GW_TOKEN=replace-me-with-32-random-chars

# The token seeded INTO Vault for profiles B and D. It must DIFFER from
# GW_TOKEN: those profiles deliberately set PRINT_GATEWAY_TOKEN to a third
# value and expect Vault to win, and GW-SEC-02a/b can only prove that if the
# two are distinguishable.
GW_VAULT_TOKEN=replace-me-with-a-different-32-chars

# ---------------------------------------------------------------------------
# Object-store backend: internal MinIO
# ---------------------------------------------------------------------------
# Uncomment and fill in to enable  profile.sh C --s3-backend internal
#S3_INTERNAL_ENDPOINT=minio.internal.example:9000
#S3_INTERNAL_BUCKET=printgw-test
#S3_INTERNAL_REGION=us-east-1
#S3_INTERNAL_INSECURE=false
#S3_INTERNAL_ACCESS_KEY=
#S3_INTERNAL_SECRET_KEY=

# ---------------------------------------------------------------------------
# Object-store backend: real AWS S3
# ---------------------------------------------------------------------------
# Endpoint form matters. cloud_storage passes it straight to minio.New, which
# detects *.amazonaws.com and switches to virtual-host addressing and SigV4 —
# so real AWS needs no code change, only the right endpoint and region.
#
# REGION IS NOT OPTIONAL IN PRACTICE. Left empty it costs a live
# bucket-location round trip on first use and, if that lookup fails, the client
# silently signs as us-east-1 — producing presigned URLs that fail for whoever
# tries to use them, with nothing server-side to trace it back to.
#
# The IAM principal needs s3:GetObject and s3:PutObject on the bucket. Bucket
# creation is NOT attempted for this backend: create it yourself first.
#
# Worth running even though it is the slowest backend: an AWS presigned URL is
# public HTTPS on port 443, so E2E-04 (presign GET -> print via file_url) is
# the ONLY file_url happy path that runs with the production SSRF guard intact.
#S3_AWS_ENDPOINT=s3.eu-west-1.amazonaws.com
#S3_AWS_BUCKET=
#S3_AWS_REGION=eu-west-1
#S3_AWS_INSECURE=false
#S3_AWS_ACCESS_KEY=
#S3_AWS_SECRET_KEY=

# ---------------------------------------------------------------------------
# Overrides (defaults come from profiles.json)
# ---------------------------------------------------------------------------
#GW_PRINTER=vp1                 # the no-paper queue used by most scenarios
#GW_PAPER_PRINTER=brother-direct # the physical printer, used only with --with-paper
#LOG_SERVER_ADDR=127.0.0.1:514
#LABOS_ENV_VALUE=               # set to prefix the Vault path, e.g. "qa"
