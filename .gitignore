# Compiled binaries (each module is rebuilt locally per CLAUDE.md's build instructions;
# CLAUDE.md's recipe builds from each module's root, so the binary lands beside go.mod,
# not nested under cmd/<name>/)
*.exe
/printersearch
/ippfix/ippfix-linux
/src/printersearch/printersearch
/src/printersearch/printersearch-linux
/src/ippfix/ippfix
/src/printgateway/printgateway-linux-amd64
/src/printgateway/printgateway

# Node (docs/*.docx generator scripts)
/docs/node_modules/

# Generated/scratch output from WSL load-test and printer-emulator runs
/src/ops/emu-spool/
/src/ops/emu15-spool/
/src/printersearch/work/
/src/printersearch/bench-payload.bin
/src/win-bench/out.prn

# MS Word lock files (created while a .docx deliverable is open)
~$*

# OS/editor cruft
.DS_Store
Thumbs.db

# printgateway config file, credential-bearing variant. /printservice.config.json
# itself stays tracked and MUST stay secret-free (a working example reproducing
# today's env-only defaults, see src/printgateway/README.md's "Configuration
# file" section) — this pattern is for a real deployment's copy, e.g. one a
# Vault Agent template renders with actual objectStore.accessKey/secretKey
# values baked in. install-services.sh prefers this file over the tracked
# example when present, specifically so a real credential is never staged
# inside the git working copy under the tracked file's own name.
/printservice.config.local.json

# docker-compose reads this automatically for PRINT_GATEWAY_TOKEN (see
# src/printgateway/docker-compose.yml and .env.example) — same
# never-commit-a-filled-in-copy rule as everywhere else.
/src/printgateway/.env

# Go module cache (GOPATH/pkg/mod), ends up under the repo root when GOPATH
# is pointed here — build cache, not source.
/pkg/

# Generated Postman/Newman run output from tests/scripts — not source.
/tests/reports/
