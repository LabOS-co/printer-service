{
  "resource/printgateway": {
    "logLevel": "info",
    "timeouts": {
      "readHeader": "10s",
      "read": "5m",
      "write": "8m",
      "idle": "60s",
      "shutdownGrace": "2m",
      "submit": "30s"
    },
    "limits": {
      "maxHeaderBytes": 65536,
      "maxUploadBytes": 67108864,
      "maxJsonBytes": 8192
    },
    "fetch": {
      "timeout": "60s",
      "maxBytes": 67108864
    },
    "objectStore": {
      "insecure": false,
      "timeout": "60s",
      "maxBytes": 67108864,
      "presignTtl": "15m"
    }
  }
}
